{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "install-all": "npm i && composer install",
        "build": "vite build",
        "dev": "vite",
        "test": "php artisan test",
        "pint:ro": "vendor/bin/pint --test",
        "pint": "vendor/bin/pint --repair",
        "analysis": "vendor/bin/phpstan analyse --memory-limit 4048M",
        "pre-push": "npm run pint:ro && npm run analysis && npm run test"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.0.0",
        "@vitejs/plugin-vue": "^6.0.0",
        "concurrently": "^9.0.1",
        "laravel-vite-plugin": "^3.1",
        "tailwindcss": "^4.0.0",
        "vite": "^8.0.0",
        "vue": "^3.5.0"
    },
    "dependencies": {
        "@inertiajs/vue3": "^3.6.1"
    }
}
